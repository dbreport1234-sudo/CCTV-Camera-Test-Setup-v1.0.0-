{
  "name": "cctv-camera-test-setup",
  "productName": "CCTV Camera Test Setup",
  "version": "1.0.0",
  "description": "โปรแกรมเช็คและตั้งค่ากล้อง IP สำหรับช่าง (RTSP / ONVIF / Dahua / Hikvision)",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "build:win": "electron-builder --win portable"
  },
  "dependencies": {
    "@cycjimmy/jsmpeg-player": "^6.1.2",
    "@fontsource/sarabun": "^5.3.0",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "ffmpeg-static": "^5.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.cctv.camera.testsetup",
    "productName": "CCTV Camera Test Setup",
    "directories": {
      "output": "release"
    },
    "files": [
      "server.js",
      "lib/**/*",
      "public/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/.cache/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "CCTV-Camera-Test-Setup-${version}.exe"
    },
    "asar": false
  }
}